<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/andamento_titulo"
        android:textSize="22sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/textDestinatario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textAvisoPermissao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#B00020"
        android:visibility="gone" />

    <TextView
        android:id="@+id/textPontos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp" />

    <Button
        android:id="@+id/botaoAtualizarContagem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/andamento_botao_atualizar" />

    <Button
        android:id="@+id/botaoAjustarBateria"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/andamento_bateria_botao"
        android:visibility="gone" />

    <TextView
        android:id="@+id/textBateria"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/andamento_bateria_texto"
        android:visibility="gone" />

    <Button
        android:id="@+id/botaoFinalizar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/andamento_botao_finalizar" />

</LinearLayout>
