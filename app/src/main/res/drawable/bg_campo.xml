<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo dos campos de texto: borda arredondada como os botões; fica vermelha quando o campo está em foco -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="@color/wa_borda_desabilitada" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke android:width="2dp" android:color="@color/wa_vermelho" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke android:width="2dp" android:color="@color/wa_vermelho" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="@color/wa_borda" />
        </shape>
    </item>
</selector>
