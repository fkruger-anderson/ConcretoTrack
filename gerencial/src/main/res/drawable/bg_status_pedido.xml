<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo do "card" da situação do pedido. A cor é aplicada no PedidoAdapter (backgroundTintList),
     conforme a situação: vermelho (pendente), amarelo (em andamento) ou verde (concluído). -->
