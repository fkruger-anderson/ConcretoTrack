<?xml version="1.0" encoding="utf-8"?>
<!-- Ponto da timeline de viagens. A cor é aplicada no ViagemAdapter conforme a situação; a borda
     da cor do fundo da tela faz o ponto "cortar" a linha vertical. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/white" />
    <stroke
        android:width="3dp"
        android:color="?android:attr/colorBackground" />
</shape>
