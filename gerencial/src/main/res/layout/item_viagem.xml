<?xml version="1.0" encoding="utf-8"?>
<!-- Um item da timeline de viagens do pedido: à esquerda a linha vertical com o ponto (colorido
     conforme a situação da viagem); à direita as informações da viagem. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="?attr/selectableItemBackground"
    android:paddingHorizontal="8dp">

    <FrameLayout
        android:layout_width="32dp"
        android:layout_height="match_parent">

        <View
            android:id="@+id/linhaSuperior"
            android:layout_width="2dp"
            android:layout_height="23dp"
            android:layout_gravity="center_horizontal|top"
            android:background="@color/timeline_linha" />

        <View
            android:id="@+id/linhaInferior"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="23dp"
            android:background="@color/timeline_linha" />

        <View
            android:id="@+id/pontoTimeline"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="15dp"
            android:background="@drawable/bg_ponto_timeline" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/textMotorista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            tools:text="Carlos Motorista — placa ABC1D23" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_peso"
                android:tint="?android:attr/textColorSecondary" />

            <TextView
                android:id="@+id/textM3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                tools:text="6 m³" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_calendario"
                android:tint="?android:attr/textColorSecondary" />

            <TextView
                android:id="@+id/textPeriodo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                tools:text="18/09/26 - 18/09/26" />
        </LinearLayout>

        <TextView
            android:id="@+id/textMotivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textStyle="italic"
            android:visibility="gone"
            tools:text="Motivo: caminhão quebrado" />

        <TextView
            android:id="@+id/textKm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:visibility="gone"
            tools:text="18,4 km percorridos" />

        <Button
            android:id="@+id/botaoCancelar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/viagem_botao_cancelar"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
