<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Gerencial" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/wa_vermelho</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/wa_vermelho_claro</item>
        <item name="colorOnPrimaryContainer">@color/wa_vermelho_escuro</item>
        <item name="colorSecondary">@color/wa_grafite</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="materialButtonStyle">@style/Widget.WA.Button</item>
        <item name="bottomNavigationStyle">@style/Widget.WA.BottomNavigationView</item>
        <item name="editTextStyle">@style/Widget.WA.EditText</item>
        <item name="android:editTextStyle">@style/Widget.WA.EditText</item>
        <item name="autoCompleteTextViewStyle">@style/Widget.WA.AutoCompleteTextView</item>
        <item name="android:autoCompleteTextViewStyle">@style/Widget.WA.AutoCompleteTextView</item>
        <item name="spinnerStyle">@style/Widget.WA.Spinner</item>
        <item name="android:spinnerStyle">@style/Widget.WA.Spinner</item>
    </style>
    <style name="Theme.Gerencial" parent="Base.Theme.Gerencial" />

    <!-- Botão padrão do app: fundo vermelho (colorPrimary) e mais alto, deixando as pontas mais arredondadas -->
    <style name="Widget.WA.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Campos de texto com o mesmo formato dos botões -->
    <style name="Widget.WA.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_campo</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <style name="Widget.WA.AutoCompleteTextView" parent="Widget.AppCompat.AutoCompleteTextView">
        <item name="android:background">@drawable/bg_campo</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <style name="Widget.WA.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/bg_spinner</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">48dp</item>
    </style>

    <!-- Barra de navegação inferior: ícone e texto do item selecionado em vermelho -->
    <style name="Widget.WA.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@color/nav_item_cor</item>
        <item name="itemTextColor">@color/nav_item_cor</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.WA.BottomNavigationView.ActiveIndicator</item>
    </style>

    <style name="Widget.WA.BottomNavigationView.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/wa_vermelho_claro</item>
    </style>

    <!-- Mensagem de "nenhum resultado" das telas de consulta: texto maior, centralizado, com a ilustração das pranchetas em cima -->
    <style name="Widget.WA.MensagemVazia" parent="">
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">32dp</item>
        <item name="android:paddingVertical">24dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="android:drawableTop">@drawable/ilustracao_vazio</item>
        <item name="android:drawablePadding">8dp</item>
    </style>
</resources>
